# Publish source code only. Keep all runtime evidence and local resources private.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/*.py
!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tests/
/tests/*
!/tests/*.py
!/balatro_ide.air/
/balatro_ide.air/*
!/balatro_ide.air/*.py

# Defensive exclusions for nested generated files and credentials.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.log
**/*.jsonl
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.bmp
**/*.gif
**/*.mp4
**/*.zip
**/*.7z
**/*.exe
**/*.dll
**/*.pyd
**/*.onnx
**/*.pem
**/*.key
