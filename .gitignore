# Publish source code and required UI templates; keep runtime evidence local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/*.py
!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tests/
/tests/*
!/tests/*.py
!/balatro_ide.air/
/balatro_ide.air/*
!/balatro_ide.air/*.py

# Defensive exclusions for nested generated files and credentials.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.log
**/*.jsonl
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.bmp
**/*.gif
**/*.mp4
**/*.zip
**/*.7z
**/*.exe
**/*.dll
**/*.pyd
**/*.onnx
**/*.pem
**/*.key

# Required runtime templates only; other images remain ignored.
!/assets/
/assets/*
!/assets/ui/
/assets/ui/*
!/assets/ui/blind.png
!/assets/ui/cashout.png
!/assets/ui/deck.png
!/assets/ui/guide.png
!/assets/ui/hand_discard_control.png
!/assets/ui/hand_play_control.png
!/assets/ui/hand_sort_control.png
!/assets/ui/loss.png
!/assets/ui/main.png
!/assets/ui/shop.png
!/assets/ui/unlock.png
